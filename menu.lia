tabs[1].Page.Visible = true

-- Botão flutuante
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.fromOffset(70, 36)
toggleBtn.Position = UDim2.new(0, 10, 0.5, -18)
toggleBtn.BackgroundColor3 = DARKPURPLE
toggleBtn.TextColor3 = WHITE
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 13
toggleBtn.Text = "MENU"
toggleBtn.Visible = false
toggleBtn.Parent = gui
corner(toggleBtn)
stroke(toggleBtn, WHITE, 1)
makeDraggable(toggleBtn, toggleBtn)

local function toggleMenu()
    menu.Visible = not menu.Visible
end

toggleBtn.MouseButton1Click:Connect(toggleMenu)
close.MouseButton1Click:Connect(function() menu.Visible = false end)

local authenticated = false

UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and authenticated and input.KeyCode == Enum.KeyCode.RightShift then
        toggleMenu()
    end
end)

enter.MouseButton1Click:Connect(function()
    if box.Text == PASSWORD then
        authenticated = true
        login:Destroy()
        menu.Visible = true
        toggleBtn.Visible = true
        notify("Acesso liberado!")
    else
        status.Text = "Senha incorreta."
        box.Text = ""
    end
end)
