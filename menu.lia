local tabs = {}

local function createTab(name)
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = PURPLE
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.CanvasSize = UDim2.new()
    page.Visible = false
    page.Parent = content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.Parent = page

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = BLACK
    btn.TextColor3 = GRAY
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Text = name
    btn.Parent = sidebar
    corner(btn, 6)

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Page.Visible = false
            t.Button.TextColor3 = GRAY
            t.Button.BackgroundColor3 = BLACK
        end
        page.Visible = true
        btn.TextColor3 = WHITE
        btn.BackgroundColor3 = DARKPURPLE
    end)

    table.insert(tabs, {Page = page, Button = btn})
    return page
end

local function addToggle(page, text, default, callback)
    local state = default
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 36)
    b.BackgroundColor3 = PANEL
    b.Text = ""
    b.Parent = page
    corner(b)

    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size = UDim2.new(1, -60, 1, 0)
    l.Position = UDim2.fromOffset(10, 0)
    l.Font = Enum.Font.Gotham
    l.TextSize = 13
    l.TextColor3 = WHITE
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Text = text
    l.Parent = b

    local sw = Instance.new("Frame")
    sw.Size = UDim2.fromOffset(38, 18)
    sw.Position = UDim2.new(1, -48, 0.5, -9)
    sw.BackgroundColor3 = BLACK
    sw.Parent = b
    corner(sw, 9)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.fromOffset(14, 14)
    dot.Position = UDim2.fromOffset(2, 2)
    dot.BackgroundColor3 = GRAY
    dot.Parent = sw
    corner(dot, 7)

    local function refresh()
        tween(dot, 0.2, {
            Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2),
            BackgroundColor3 = state and WHITE or GRAY,
        })
        tween(sw, 0.2, {BackgroundColor3 = state and PURPLE or BLACK})
    end

    b.MouseButton1Click:Connect(function()
        state = not state
        refresh()
        callback(state)
    end)

    refresh()
    callback(state)
end

local function addSlider(page, text, min, max, default, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -6, 0, 50)
    holder.BackgroundColor3 = PANEL
    holder.Parent = page
    corner(holder)

    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size = UDim2.new(1, -20, 0, 22)
    l.Position = UDim2.fromOffset(10, 3)
    l.Font = Enum.Font.Gotham
    l.TextSize = 13
    l.TextColor3 = WHITE
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = holder

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 6)
    bar.Position = UDim2.fromOffset(10, 32)
    bar.BackgroundColor3 = BLACK
    bar.Parent = holder
    corner(bar, 3)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = PURPLE
    fill.Parent = bar
    corner(fill, 3)

    local value = default
    local function set(v)
        value = math.clamp(math.floor(v + 0.5), min, max)
        fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
        l.Text = text .. ": " .. value
        callback(value)
    end

    local sliding = false
    local function update(x)
        local p = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        set(min + (max - min) * p)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)

    set(default)
end

local function addButton(page, text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 36)
    b.BackgroundColor3 = DARKPURPLE
    b.TextColor3 = WHITE
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.Text = text
    b.Parent = page
    corner(b)
    b.MouseButton1Click:Connect(callback)
end

-- HUD (FPS e relógio)
local hud = Instance.new("TextLabel")
hud.Size = UDim2.fromOffset(170, 26)
hud.Position = UDim2.fromOffset(10, 10)
hud.BackgroundColor3 = BLACK
hud.BackgroundTransparency = 0.2
hud.TextColor3 = PURPLE
hud.Font = Enum.Font.GothamBold
hud.TextSize = 13
hud.Visible = false
hud.Parent = gui
corner(hud, 6)
stroke(hud)

local showFPS, showClock = false, false
local frames, fps, last = 0, 0, tick()

RunService.RenderStepped:Connect(function()
    frames += 1
    if tick() - last >= 1 then
        fps = frames
        frames = 0
        last = tick()
    end
    local parts = {}
    if showFPS then table.insert(parts, "FPS: " .. fps) end
    if showClock then table.insert(parts, os.date("%H:%M:%S")) end
    hud.Visible = #parts > 0
    hud.Text = table.concat(parts, "  •  ")
end)

-- Abas
