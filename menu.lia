welcome.Parent = inicio
corner(welcome)

addButton(inicio, "Testar notificação", function()
    notify("Menu funcionando! 💜")
end)

addToggle(visual, "Mostrar FPS", false, function(v) showFPS = v end)
addToggle(visual, "Mostrar relógio", false, function(v) showClock = v end)
